# Copy to .env. Relative paths resolve against this project, not your terminal.
# KARAOKE_FFMPEG=/usr/bin/ffmpeg
# KARAOKE_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# KARAOKE_DEMUCS_PYTHON=.venv-demucs/bin/python
# KARAOKE_WORK_DIR=work/local_open_source
# KARAOKE_OUTPUT_DIR=out
# KARAOKE_MODEL_DIR=models
# KARAOKE_LOGO=assets/logo.png
# Omit KARAOKE_DEVICE for automatic CUDA/CPU selection.
# KARAOKE_DEVICE=cpu
KARAOKE_ALLOW_MODEL_DOWNLOAD=1
KARAOKE_THREADS=2
# Optional local translation service. Remote endpoints are opt-in.
LLM_URL=http://localhost:11434/v1/chat/completions
LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=

# Countdown ring: arc (closes) or circle (stays complete)
KARAOKE_COUNTDOWN_STYLE=arc
KARAOKE_COUNTDOWN_COLOUR="#BB3794"

# Docker server configuration (non-secret; tracked in Git).
KARAOKE_MEDIA_HOST_DIR="D:/Application/Website/ftpPrivate/Danish New"
KARAOKE_UID=10001
KARAOKE_GID=10001
KARAOKE_DOCKER_CPUS=8
KARAOKE_DOCKER_MEMORY=12g
KARAOKE_SERVER_THREADS=2
KARAOKE_SERVER_MODEL=htdemucs
KARAOKE_LANGUAGE=auto
KARAOKE_SERVER_PARALLEL=1
KARAOKE_SETTLE_SECONDS=30
KARAOKE_CLEANUP_AFTER_RUN=1
KARAOKE_LOGO=assets/logo-karaoke-cmyk-transparent.png
KARAOKE_SERVER_WORKERS=3
KARAOKE_CLEANUP_AFTER_SONG=1
KARAOKE_DELIVERY_MODE=automatic
KARAOKE_SERVER_AUDIO_FALLBACK=0
KARAOKE_SERVER_ATTEMPTS=2
KARAOKE_OCR_WORKERS=2
