# Optional compatibility file; plain docker compose uses .env.
KARAOKE_MEDIA_HOST_DIR="D:/Application/Website/ftpPrivate/Basic & More Danish/MP4/normalized"
KARAOKE_UID=10001
KARAOKE_GID=10001
KARAOKE_DOCKER_CPUS=8
KARAOKE_DOCKER_MEMORY=12g
KARAOKE_SERVER_THREADS=2
KARAOKE_SERVER_MODEL=htdemucs
KARAOKE_LANGUAGE=auto
KARAOKE_SERVER_PARALLEL=1
KARAOKE_SETTLE_SECONDS=30
KARAOKE_CLEANUP_AFTER_RUN=1
KARAOKE_COUNTDOWN_STYLE=arc
KARAOKE_COUNTDOWN_COLOUR="#BB3794"
KARAOKE_ALLOW_MODEL_DOWNLOAD=1
KARAOKE_LOGO=assets/logo-karaoke-cmyk-transparent.png
KARAOKE_SERVER_WORKERS=3
KARAOKE_CLEANUP_AFTER_SONG=1
KARAOKE_DELIVERY_MODE=automatic
KARAOKE_SERVER_AUDIO_FALLBACK=0
KARAOKE_SERVER_ATTEMPTS=2
KARAOKE_OCR_WORKERS=2

# Relative to the compose project directory; server project is on D:.
KARAOKE_DATA_HOST_DIR=./docker-data

KARAOKE_MELLOW_HOST_DIR="D:/Application/Website/ftpPrivate/Danish Mellow/normalization-mp4/MP4"
KARAOKE_DB_HOST_DIR="D:/Application/Website/ftpPrivate/Danish DB Songs/mp4"

# Scan only the normalized input; legacy mounts remain available but inactive.
KARAOKE_EXTRA_INPUT_DIRS=[]

# One folder, selected input workflow: mp4 | mp3 | zoom | singking
KARAOKE_SOURCE_TYPE=mp4
# auto: MP4 keeps its video; MP3/Zoom/Sing King use AUDIO_BACKGROUND.
KARAOKE_BACKGROUND=auto
KARAOKE_AUDIO_BACKGROUND=assets/audio-bg/6.jpeg
# auto: Zoom white-blue; Sing King white-magenta. Override for the source.
KARAOKE_SCREEN_PROFILE=auto
