# Deployment files and non-secret environment settings are intentionally tracked.
!.env
!.env.example
!.env.docker
!.env.docker.example
!Dockerfile
!docker-compose.yml
!.dockerignore
# Put credentials in private overrides, never the tracked .env.
.env.local
.env.secrets
*.pem
*.key
