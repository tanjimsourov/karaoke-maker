node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
tools/ffmpeg/
/inputs/
/models/
/work/
/out/
/output/
/reports/
/tmp/
/delivery/
/samples/
*.log
*.part
*.script-part
*.mp3
*.mp4
*.wav
*.m4a
*.webm
*.mkv
/*.png
/*.jpg
/*.jpeg
!assets/**
!audio-bg-sample/**
